#!/bin/bash

#SBATCH --account=coreai_dlalgo_nemorl
#SBATCH --exclusive
#SBATCH --partition=batch
#SBATCH --job-name=general_sa-verl.sglang_bf16_longrun
#SBATCH --mail-type=ALL
#SBATCH --ntasks-per-node=1
#SBATCH --nodes=4
#SBATCH --gres=gpu:4
#SBATCH --time=3:59:00
#SBATCH --output=./slurm/%j.out
#SBATCH --error=./slurm/%j.err
##SBATCH --overcommit

set -x

CONTAINER="/lustre/fsw/portfolios/coreai/users/larkz/docker_images/sglang_62.sqsh"

MOUNTS=""
current_dir=$(pwd)
MOUNTS+="${current_dir}/..:/apps"
export HF_HOME=/apps/.cache
RAY_TMP_DIR="/tmp/ray-${USER}-${SLURM_JOB_ID}"
mkdir -p "${RAY_TMP_DIR}"
MOUNTS+=",${RAY_TMP_DIR}:/tmp/ray"


current_time=$(date +"%Y%m%d_%H%M")
WBPROJECT=verl_${current_time}
echo $WBPROJECT

# Necessary Exports
export HYDRA_FULL_ERROR=1
#export TRANSFORMERS_OFFLINE=1
export NCCL_AVOID_RECORD_STREAMS=1
export VERL_DISABLE_TORCH_SAVE_CRC32=1
#export ENROOT_ROOTFS_WRITABLE=1


mkdir -p logs

JOBLOG="$(realpath .)/logs/verl_8b_sglang_bf16-$SLURM_JOB_ID.log"
echo "$(date '+%Y-%m-%d %H:%M:%S') Job ${SLURM_JOB_ID} started ..." &>> ${JOBLOG}
ray_pids=()

cleanup() {
    for pid in "${ray_pids[@]}"; do
        if kill -0 "$pid" 2>/dev/null; then
            kill "$pid"
        fi
    done
}
trap cleanup EXIT

# launch ray daemon
nodes=$(scontrol show hostnames "$SLURM_JOB_NODELIST") # Getting the node names
nodes_array=( $nodes )
node_1=${nodes_array[0]}
ip=$node_1

# The /tmp source used for the container Ray mount must exist on every
# allocated node before the per-node containerized ray start commands run.
srun --nodes="${SLURM_JOB_NUM_NODES}" --ntasks="${SLURM_JOB_NUM_NODES}" \
    bash -c "mkdir -p ${RAY_TMP_DIR}"

port=6379
ip_head=$ip:$port
export ip_head
echo "IP Head: $ip_head"  &>> ${JOBLOG}

echo "STARTING HEAD at $node_1"  &>> ${JOBLOG}
srun --nodes=1 --ntasks=1 -w "$node_1" --container-image="$CONTAINER" --no-container-mount-home --container-mounts="$MOUNTS" bash -c "
    export WANDB_API_KEY=149737fd3c4537b349a37aab90b6fff96f385ebc &&
    export HF_HOME=/apps/.cache &&
    export VERL_DISABLE_TORCH_SAVE_CRC32=1 &&
    export ROCR_VISIBLE_DEVICES= &&
    ray start --head --node-ip-address=$ip --num-gpus=4 --port=$port --block
" &>> ${JOBLOG} &
ray_pids+=($!)
sleep 20s

worker_num=$((SLURM_JOB_NUM_NODES)) #number of nodes other than the head node
for ((i = 1; i < worker_num; i++)); do
node_i=${nodes_array[$i]}
echo "STARTING WORKER $i at $node_i"  &>> ${JOBLOG}
srun --nodes=1 --ntasks=1 -w "$node_i" --container-image="$CONTAINER" --no-container-mount-home --container-mounts="$MOUNTS" bash -c "
    export WANDB_API_KEY=149737fd3c4537b349a37aab90b6fff96f385ebc &&
    export HF_HOME=/apps/.cache &&
    export VERL_DISABLE_TORCH_SAVE_CRC32=1 &&
    export ROCR_VISIBLE_DEVICES= &&
    ray start --address $ip_head --num-gpus 4 --block" &>> ${JOBLOG} &
ray_pids+=($!)
sleep 2s
done

sleep 30s


read -r -d '' cmd <<EOF
echo "*******STARTING********" \
&& echo "---------------" \
&& ray status --address=${ip_head} \
&& export WANDB_API_KEY=149737fd3c4537b349a37aab90b6fff96f385ebc \
&& export HF_HOME=/apps/.cache \
&& export VERL_DISABLE_TORCH_SAVE_CRC32=1 \
&& export NNODES=${SLURM_JOB_NUM_NODES} \
&& export RAY_ADDRESS=${ip_head} \
&& export PROJECT_NAME=DAPO-mxfp8-longrun-4n \
&& export TRAINER_TEST_FREQ=10 \
&& export TRAINER_SAVE_FREQ=5 \
&& export TRAINER_RESUME_MODE=auto \
&& export MAX_RESPONSE_LENGTH=20480 \
&& export ROLLOUT_ENFORCE_EAGER=True \
&& export CKPTS_DIR=/apps/ckpts/DAPO-mxfp8-longrun-4n/dapo-qwen3-8b-megatron-sglang-bf16-4n-longrun-rsp20k \
&& cd /apps/verl/ \
&& bash recipe/dapo/dapo_baseline_new.sh dapo-qwen3-8b-megatron-sglang-bf16-4n-longrun-rsp20k
EOF


# ===== submit ray job =====
# Job start
srun --overlap --nodes=1 --ntasks=1 -w "$node_1" --container-image="$CONTAINER" --no-container-mount-home --container-mounts="$MOUNTS" bash -c \
    "$cmd" &>> ${JOBLOG}

echo "$(date '+%Y-%m-%d %H:%M:%S') Job ${SLURM_JOB_ID} stopped ..." &>> ${JOBLOG}
